<div class="min-h-screen flex items-center justify-center p-6">
  <div class="relative w-full max-w-3xl bg-base-100 p-8 rounded-xl shadow-md text-center">
    <!-- small theme toggle positioned at top-right of the content -->
    <div class="absolute top-4 right-4 transform scale-75">
      <Layouts.theme_toggle />
    </div>

    <h1 class="text-4xl font-bold">unclickbaiter</h1>
    <p class="mt-4 text-lg text-muted">
      Alternative social-media previews to existing pages
    </p>

    <div class="mt-6">
      <Layouts.flash_group flash={@flash} />
    </div>

    <%= if @current_scope && @current_scope.user do %>
      <div class="mt-8">
        <.button id="browse-previews-link" href={~p"/p"} variant="primary">
          <.icon name="hero-squares-2x2" class="size-4" /> Browse previews
        </.button>
      </div>
    <% end %>
  </div>
</div>
