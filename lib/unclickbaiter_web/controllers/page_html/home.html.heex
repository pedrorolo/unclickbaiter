<div class="min-h-screen flex items-center justify-center p-6">
  <div class="relative w-full max-w-3xl bg-base-100 p-8 rounded-xl shadow-md text-center">
    <!-- small theme toggle positioned at top-right of the content -->
    <div class="absolute top-4 right-4 transform scale-75">
      <Layouts.theme_toggle />
    </div>

    <h1 class="text-4xl font-bold">unclickbaiter</h1>
    <p class="mt-4 text-lg text-muted">
      Alternative social-media previews to existing pages
    </p>

    <div class="mt-6">
      <Layouts.flash_group flash={@flash} />
    </div>

    <%= if @current_scope && @current_scope.user do %>
      <div class="mt-8 flex flex-col gap-4 items-center">
        <div class="flex gap-4">
          <.button id="create-preview-link" href={~p"/p/new"} variant="primary">
            <.icon name="hero-squares-2x2" class="size-4" /> Create preview
          </.button>
          <.button id="my-previews-link" href={~p"/p"} variant="primary">
            <.icon name="hero-squares-2x2" class="size-4" /> My previews
          </.button>
        </div>
        <.link href={~p"/log-out"} method="delete" class="btn btn-ghost">
          <.icon name="hero-arrow-right-on-rectangle" class="size-4" /> Log out
        </.link>
      </div>
    <% else %>
      <div class="mt-8 flex flex-col gap-4 items-center">
        <.button
          id="signup-link"
          href={~p"/auth/google"}
          variant="primary"
          class="btn btn-lg"
        >
          <.icon name="hero-user-plus" class="size-4" /> Sign up with Google
        </.button>
      </div>
    <% end %>
  </div>
</div>
