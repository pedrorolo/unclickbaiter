# Erlang version
erlang_version=29.0.5

# Elixir version
elixir_version=1.20.3

# Always rebuild from scratch on every deploy?
# always_rebuild=true

# Create a release using `mix release`? (requires Elixir 1.9)
# release=true

# A command to run right before fetching dependencies
# hook_pre_fetch_dependencies="pwd"

# A command to run right before compiling the app (after elixir, .etc)
# hook_pre_compile="pwd"

hook_compile="mix compile --force --warnings-as-errors"

# A command to run right after compiling the app
# If credo or tests fail, the hook will return a non-zero exit code and the build will fail.
# Runs credo in strict mode and then runs tests with coverage.
hook_post_compile="if MIX_ENV=dev mix help --tasks | grep -q 'credo'; then MIX_ENV=dev mix credo --strict; else echo 'credo not found; failing build as configured' && exit 1; fi && MIX_ENV=test mix test --cover"

# Set the path the app is run from
runtime_path=/app

# Enable or disable additional test arguments
test_args="--cover"
